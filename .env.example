# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# TMDB (The Movie Database) — used for Movie/Series metadata search.
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# RAWG (video game database) — used for Game metadata search.
# Get a free API key at https://rawg.io/apidocs
RAWG_API_KEY=

# Supabase — optional. Enables account sign-up/sign-in and cross-device
# cloud sync (see README.md "Environment Variables"). Leave both unset to
# run Markly entirely in local mode; nothing else needs to change.
#
# Both are safe to expose in client code (NEXT_PUBLIC_*): the anon key
# relies on Row Level Security, not secrecy, to protect data. NEVER put a
# Supabase service-role key here or anywhere client-reachable.
#
# Find these under your Supabase project's Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AniList connected account (Stage 17) — optional, requires Supabase to be
# configured above (connections only exist in account/cloud mode). Create
# an app at https://anilist.co/settings/developer — see README.md
# "Connected Accounts" for the exact redirect URI and setup steps.
# ANILIST_CLIENT_SECRET must NEVER be exposed to the browser — do not
# prefix any of these with NEXT_PUBLIC_.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://localhost:3000/api/integrations/anilist/callback

# Server-only key used to encrypt stored AniList access tokens at rest
# (AES-256-GCM). Generate one with `openssl rand -base64 32`. Never expose
# this to the browser; losing/rotating it invalidates every stored
# connection (users would need to reconnect).
MARKLY_INTEGRATION_ENCRYPTION_KEY=

# Browser extension auto-tracking (Stage 18) — optional, requires Supabase
# to be configured above. The extension authenticates with its own
# device token (see README.md "Auto Tracking"), not a Supabase session,
# so the two extension-facing routes (/api/extension/pair and
# /api/extension/progress) need a privileged server-side client to look
# up which user a device token belongs to and act on that user's data.
# This is your Supabase project's Secret API Key, found under Settings ->
# API Keys -> Secret keys (the current replacement for the legacy
# "service_role" key). It bypasses Row Level Security entirely — it is
# NEVER sent to the browser or the extension, is read only inside
# src/lib/supabase/admin.ts, and must NEVER be prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy fallback, only for older Supabase projects that still issue a
# service_role JWT instead of a Secret API Key. Leave unset if you filled
# in SUPABASE_SECRET_KEY above — it takes priority. Same server-only rules
# apply: NEVER prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
